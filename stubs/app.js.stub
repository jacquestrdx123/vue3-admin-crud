import './bootstrap';
import '../css/app.css';

import { createApp, h } from 'vue';
import { createInertiaApp } from '@inertiajs/vue3';
import { resolvePageComponent } from 'laravel-vite-plugin/inertia-helpers';
import { ZiggyVue } from 'ziggy-js';

createInertiaApp({
    title: (title) =>
        title
            ? `${title} - ${import.meta.env.VITE_APP_NAME || 'Laravel'}`
            : import.meta.env.VITE_APP_NAME || 'Laravel',
    resolve: (name) => {
        const appPages = import.meta.glob('./Pages/**/*.vue', { eager: true });
        const vendorPages = import.meta.glob('./vendor/inertia-resource/Pages/**/*.vue', { eager: true });
        
        // If name starts with vendor/, resolve directly from vendor pages
        if (name.startsWith('vendor/')) {
            const vendorPagePath = `./${name}.vue`;
            if (vendorPages[vendorPagePath]) {
                return resolvePageComponent(vendorPagePath, vendorPages);
            }
            // If vendor path doesn't exist, throw appropriate error
            return resolvePageComponent(vendorPagePath, vendorPages);
        }
        
        // Try app Pages first
        const appPagePath = `./Pages/${name}.vue`;
        if (appPages[appPagePath]) {
            return resolvePageComponent(appPagePath, appPages);
        }
        
        // Fall back to vendor pages
        const vendorPagePath = `./vendor/inertia-resource/Pages/${name}.vue`;
        if (vendorPages[vendorPagePath]) {
            return resolvePageComponent(vendorPagePath, vendorPages);
        }
        
        // If neither exists, try with app pages (will throw appropriate error)
        return resolvePageComponent(appPagePath, appPages);
    },
    setup({ el, App, props, plugin }) {
        return createApp({ render: () => h(App, props) })
            .use(plugin)
            .use(ZiggyVue)
            .mount(el);
    },
    progress: {
        color: '#4B5563',
    },
});

